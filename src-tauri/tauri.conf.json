{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pandock",
  "version": "1.2.1",
  "identifier": "com.weyham.pandock",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pandock 设置",
        "width": 920,
        "height": 640,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": "all",
    "publisher": "Weyham",
    "copyright": "Copyright (c) 2026 Weyham. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Local WebDAV bridge for the Baidu Netdisk Open Platform application directory."
  }
}
